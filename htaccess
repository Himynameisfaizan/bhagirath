RewriteEngine On

# Sitemap routing
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Do not redirect location.php to blog details
RewriteRule ^location\.php$ - [L]

# Redirect only non-existing PHP URLs to blog details
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)\.php$ /blog-details.php?slug=$1 [R=302,L,QSA]